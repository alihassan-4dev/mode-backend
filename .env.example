# Local SQLite 3 (default): no DATABASE_URL needed. DB file: backend/db/app.db
USE_LOCAL_SQLITE=true

# Only when USE_LOCAL_SQLITE=false: set a remote DSN, e.g. postgresql+asyncpg://user:pass@host/db
# DATABASE_URL=
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# API server
PORT=8000

# Frontend URL (used for OAuth callback redirects)
# Use the actual frontend dev server URL. Common local values are 8080 or 8081.
FRONTEND_URL=http://localhost:8080

# Optional: public HTTPS base URL of THIS API (no trailing slash). Required if Meta/Facebook
# rejects http:// — use ngrok/cloudflare tunnel and paste the https://... URL here.
# Redirect URIs in Meta must then be: https://YOUR_TUNNEL/api/integrations/facebook/callback
# and for Instagram: https://YOUR_TUNNEL/api/integrations/instagram/callback
# PUBLIC_API_BASE_URL=
#
# Optional explicit callback overrides (recommended in production to avoid redirect mismatch):
# FACEBOOK_REDIRECT_URI=https://api.yourdomain.com/api/integrations/facebook/callback
# INSTAGRAM_REDIRECT_URI=https://api.yourdomain.com/api/integrations/instagram/callback

# Comma-separated browser origins (no spaces). Add production URLs when you deploy.
# Include every local frontend origin you use during development.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# Meta (Facebook + Instagram) OAuth
# Shared fallback app (used when platform-specific keys below are not set)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Optional but recommended: platform-specific app credentials
# FB_APP_ID=your-facebook-app-id
# FB_APP_SECRET=your-facebook-app-secret
# IG_APP_ID=your-instagram-app-id
# IG_APP_SECRET=your-instagram-app-secret
META_STATE_SECRET=generate-a-random-32-char-string

# Groq / LangChain agent
# Groq is OpenAI-compatible. The backend uses LangChain ChatOpenAI with the Groq base URL below.
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
AGENT_GROQ_MODEL=llama-3.3-70b-versatile
AGENT_SYSTEM_NAME=Counseling Corner
AGENT_TEMPERATURE=0.2

# Chat memory:
# `session` keeps conversation memory only in the running backend process.
# `persistent` stores chat history in the database.
CHAT_HISTORY_MODE=session
